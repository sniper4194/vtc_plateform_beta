{
  "name": "vtc-platform",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "db:up": "docker compose -f infra/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "setup:env": "node scripts/setup-env.mjs",
    "setup:build": "pnpm -F @vtc/pricing -F @vtc/shared build && pnpm -F @vtc/api exec prisma generate",
    "demo": "node scripts/demo.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild"
    ],
    "overrides": {
      "body-parser": ">=1.20.9 <2",
      "qs": ">=6.15.2 <7",
      "multer": ">=2.3.0 <3"
    }
  }
}
