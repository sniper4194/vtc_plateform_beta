generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VehicleCategory {
  BERLINE
  BUSINESS
  VAN
  GREEN
}
enum RideStatus {
  CREATED
  QUOTED
  CONFIRMED
  DISPATCHING
  ASSIGNED
  EN_ROUTE
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED_BY_CLIENT
  CANCELLED_BY_PARTNER
  NO_SHOW
  DISPUTED
  REFUNDED
}
enum DriverStatus {
  PENDING_DOCUMENTS
  PENDING_REVIEW
  ACTIVE
  SUSPENDED
  REJECTED
}
enum DriverAvailability {
  AVAILABLE
  SUSPENDED
  BUSY
}
enum DocumentType {
  VTC_CARD
  DRIVING_LICENSE
  KBIS
  INSURANCE
  REGISTRATION_CERT
  TECHNICAL_INSPECTION
  ID
}
enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}
enum OfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}
enum PayoutStatus {
  PENDING
  PAID
  FAILED
}
enum PaymentMode {
  PREPAID
  INVOICE
}

model Partner {
  id               String        @id @default(uuid())
  name             String
  paymentMode      PaymentMode   @default(INVOICE)
  priceMultiplier  Decimal       @default(1) @db.Decimal(5, 4)
  commissionRate   Decimal       @default(0.2) @db.Decimal(5, 4)
  webhookUrl       String?
  webhookSecret    String?
  active           Boolean       @default(true)
  createdAt        DateTime      @default(now())
  apiKeys          ApiKey[]
  bookings         Booking[]
  quotes           Quote[]
  deliveries       WebhookDelivery[]
}

model ApiKey {
  id         String    @id @default(uuid())
  partnerId  String
  partner    Partner   @relation(fields: [partnerId], references: [id])
  /// Hash SHA-256 de la clé ; la clé en clair n'est jamais stockée
  keyHash    String    @unique
  prefix     String
  sandbox    Boolean   @default(true)
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
}

model Company {
  id         String   @id @default(uuid())
  name       String
  siret      String?  @unique
  vtcRegistry String?
  iban       String?
  active     Boolean  @default(true)
  /// Clé d'accès de l'espace société (hash SHA-256 ; la clé en clair n'est jamais stockée)
  accessKeyHash   String? @unique
  accessKeyPrefix String?
  drivers    Driver[]
  vehicles   Vehicle[]
  createdAt  DateTime @default(now())
}

model Driver {
  id            String             @id @default(uuid())
  companyId     String?
  company       Company?           @relation(fields: [companyId], references: [id])
  firstName     String
  lastName      String
  phone         String             @unique
  email         String             @unique
  language      String             @default("fr")
  status        DriverStatus       @default(PENDING_DOCUMENTS)
  availability  DriverAvailability @default(SUSPENDED)
  rating        Float              @default(5)
  reliability   Float              @default(1)
  contractSignedAt DateTime?
  stripeAccountId String?
  suspendedBy   String? // "admin" | "company" : une société ne peut lever que sa propre suspension
  lastLat       Float?
  lastLng       Float?
  lastSeenAt    DateTime?
  documents     Document[]
  vehicles      Vehicle[]
  rides         Ride[]
  offers        DispatchOffer[]
  payouts       Payout[]
  createdAt     DateTime           @default(now())
}

model Vehicle {
  id        String          @id @default(uuid())
  companyId String?
  company   Company?        @relation(fields: [companyId], references: [id])
  driverId  String?
  driver    Driver?         @relation(fields: [driverId], references: [id])
  plate     String          @unique
  make      String
  model     String
  color     String?
  category  VehicleCategory
  seats     Int             @default(4)
  electric  Boolean         @default(false)
  active    Boolean         @default(true)
  rides     Ride[]
}

model Document {
  id         String         @id @default(uuid())
  driverId   String
  driver     Driver         @relation(fields: [driverId], references: [id])
  type       DocumentType
  storageKey String
  status     DocumentStatus @default(PENDING)
  expiresAt  DateTime?
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime       @default(now())

  @@index([driverId, type])
}

model Booking {
  id                String   @id @default(uuid())
  partnerId         String?
  partner           Partner? @relation(fields: [partnerId], references: [id])
  externalReference String?
  idempotencyKey    String?
  passengerFirstName String
  passengerLastName  String
  passengerPhone     String
  passengerEmail     String?
  passengerLanguage  String  @default("fr")
  flightNumber      String?
  signText          String? // texte de la pancarte (par défaut : nom du passager)
  notes             String? // consignes de rendez-vous (terminal, porte…)
  createdAt         DateTime @default(now())
  rides             Ride[]

  @@unique([partnerId, idempotencyKey])
}

model Ride {
  id             String          @id @default(uuid())
  bookingId      String
  booking        Booking         @relation(fields: [bookingId], references: [id])
  status         RideStatus      @default(CREATED)
  category       VehicleCategory
  pickupAddress  String
  pickupLat      Float
  pickupLng      Float
  dropoffAddress String
  dropoffLat     Float
  dropoffLng     Float
  pickupAt       DateTime
  distanceKm     Float
  durationMin    Float
  passengers     Int             @default(1)
  luggage        Int             @default(0)
  /// Montants en centimes (évite les erreurs d'arrondi)
  priceCents     Int
  commissionCents Int
  driverNetCents Int
  flatRateId     String?
  /// Suivi de vol : retard (min) à ajouter à pickupAt, heure d'arrivée estimée, statut
  flightDelayMin   Int       @default(0)
  flightEstimatedAt DateTime?
  flightStatus     String?
  driverId       String?
  driver         Driver?         @relation(fields: [driverId], references: [id])
  vehicleId      String?
  vehicle        Vehicle?        @relation(fields: [vehicleId], references: [id])
  version        Int             @default(0) // verrou optimiste
  events         RideEvent[]
  offers         DispatchOffer[]
  ratings        Rating[]
  createdAt      DateTime        @default(now())

  @@index([status, pickupAt])
  @@index([driverId, pickupAt])
}

model RideEvent {
  id        String   @id @default(uuid())
  rideId    String
  ride      Ride     @relation(fields: [rideId], references: [id])
  type      String
  payload   Json?
  actor     String?
  createdAt DateTime @default(now())

  @@index([rideId, createdAt])
}

model DispatchOffer {
  id        String      @id @default(uuid())
  rideId    String
  ride      Ride        @relation(fields: [rideId], references: [id])
  driverId  String
  driver    Driver      @relation(fields: [driverId], references: [id])
  status    OfferStatus @default(PENDING)
  expiresAt DateTime
  createdAt DateTime    @default(now())

  @@unique([rideId, driverId])
  @@index([status, expiresAt])
}

model Rating {
  id        String   @id @default(uuid())
  rideId    String   @unique
  ride      Ride     @relation(fields: [rideId], references: [id])
  score     Int
  comment   String?
  createdAt DateTime @default(now())
}

model Payout {
  id          String       @id @default(uuid())
  driverId    String
  driver      Driver       @relation(fields: [driverId], references: [id])
  amountCents Int
  status      PayoutStatus @default(PENDING)
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime     @default(now())
}

model PricingRuleSet {
  id        String   @id @default(uuid())
  name      String
  config    Json
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model FlatRate {
  id        String @id @default(uuid())
  fromZone  String
  toZone    String
  bidirectional Boolean @default(true)
  prices    Json
}

model AuditLog {
  id        String   @id @default(uuid())
  actor     String
  action    String
  entity    String
  entityId  String
  data      Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}

enum DeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

model Quote {
  id              String          @id @default(uuid())
  partnerId       String
  partner         Partner         @relation(fields: [partnerId], references: [id])
  request         Json
  category        VehicleCategory
  pickupAt        DateTime
  distanceKm      Float
  durationMin     Float
  priceCents      Int
  commissionCents Int
  driverNetCents  Int
  flatRateId      String?
  expiresAt       DateTime
  usedAt          DateTime?
  createdAt       DateTime        @default(now())
}

/// Outbox : un événement est enregistré dans la même transaction que le changement d'état,
/// puis livré (avec reprises) par un worker.
model WebhookDelivery {
  id            String         @id @default(uuid())
  partnerId     String
  partner       Partner        @relation(fields: [partnerId], references: [id])
  eventType     String
  payload       Json
  status        DeliveryStatus @default(PENDING)
  attempts      Int            @default(0)
  nextAttemptAt DateTime       @default(now())
  lastError     String?
  createdAt     DateTime       @default(now())

  @@index([status, nextAttemptAt])
}
