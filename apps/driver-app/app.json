{
  "expo": {
    "name": "CliCab Chauffeur",
    "slug": "clicab-driver",
    "version": "0.0.2",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/notification_course.wav",
            "./assets/sounds/notification_atterrissage.wav"
          ]
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Votre position sert à vous proposer les courses proches."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "La caméra sert à prendre vos photos-preuves (client absent, bagages) et votre selfie.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "La caméra sert à prendre votre selfie de vérification d'identité.",
          "photosPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.clicab.driver",
      "supportsTablet": false
    },
    "android": {
      "package": "com.clicab.driver",
      "versionCode": 2,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b2a4a"
      }
    },
    "icon": "./assets/icon.png"
  }
}
