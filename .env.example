DATABASE_URL=postgresql://vtc:vtc@localhost:5432/vtc?schema=public
PORT=3000
# Obligatoires en production (≥ 24 / ≥ 32 caractères)
ADMIN_TOKEN=change-me-change-me-change-me
TOKEN_SECRET=change-me-change-me-change-me-change-me
# Connexion chauffeur : code SMS à usage unique. En développement, les SMS sont écrits dans les journaux de l'API.
# DRIVER_DEV_OTP : code fixe accepté en dev UNIQUEMENT (utile pour le simulateur et les tests) ; refusé au démarrage en production.
DRIVER_DEV_OTP=000000
# Planning des chauffeurs (valeurs à confirmer) : maximum d'heures de mission sur 24 h (0 = désactivé),
# missions de retour (rayon en km autour de l'arrivée, délai max en minutes), rayon d'un point de rendez-vous (m).
# FATIGUE_MAX_MISSION_HOURS=10
# RETURN_RADIUS_KM=3
# RETURN_WINDOW_MIN=120
# MEETING_POINT_RADIUS_M=500
# Alerte « course à risque » : minutes avant la prise en charge où une course encore sans chauffeur est signalée (à confirmer)
# GUARANTEE_ALERT_MIN=180
# Bourse d'échange : un chauffeur peut proposer sa mission à un collègue, sans pénalité, jusqu'à N heures avant (à confirmer)
# SWAP_MIN_HOURS=48
# Objet oublié : jours après la fin du trajet pendant lesquels le voyageur peut le signaler (à confirmer)
# LOST_ITEM_DAYS=7
# LOST_ITEM_IP_PER_HOUR=10
# Bilan carbone : AUCUNE valeur par défaut. Relever les facteurs dans la Base Empreinte de l'ADEME (base-empreinte.ademe.fr,
# « voiture particulière »), en kgCO2e par km et par véhicule, et indiquer la version. Sans eux, le bilan reste désactivé.
# CARBON_FACTOR_THERMAL=
# CARBON_FACTOR_HYBRID=
# CARBON_FACTOR_ELECTRIC=
# Prime de parrainage : DÉSACTIVÉE tant qu'un juriste n'a pas validé le principe (un seul niveau, plafonnée, prise sur la commission).
# Montant et nombre de courses : valeurs de départ, à confirmer.
# REFERRAL_REWARD_ENABLED=0
# Mise en commun entre sociétés : délai minimal avant la prise en charge (h) et part du net reversée à la société d'origine (%, 50 max). À confirmer.
# POOL_MIN_HOURS=24
# Page de réservation clé en main (/reserver/…) : limite de réservations par adresse IP et par heure (devis : 60)
# HOSTED_IP_PER_HOUR=10
# POOL_SHARE_PERCENT=0
# REFERRAL_REWARD_CENTS=100
# REFERRAL_REWARD_RIDES=10
# CARBON_SOURCE=Base Empreinte ADEME, version …, voiture particulière …

# Alertes : lien d'un « webhook entrant » Discord / Slack / Mattermost. Reçoit les erreurs graves de l'API et les plantages de l'application chauffeur.
# ERROR_WEBHOOK_URL=
# Numéro professionnel proposé aux chauffeurs qui envisagent de rendre une mission.
# CONTROL_TOWER_PHONE=

# Prime écologique : % du prix client versé au chauffeur en véhicule électrique (prélevée sur la commission ; 0 = désactivée). Défaut : 3
# ECO_BONUS_PERCENT=3

# Fournisseur SMS : console (dev) | ovh | twilio
SMS_PROVIDER=console
OVH_APP_KEY=
OVH_APP_SECRET=
OVH_CONSUMER_KEY=
OVH_SMS_SERVICE=
OVH_SMS_SENDER=
# Infobip : SMS_PROVIDER=infobip ; adresse personnelle (portail Infobip, du type xxxxx.api.infobip.com), clé d'API, expéditeur
INFOBIP_BASE_URL=
INFOBIP_API_KEY=
INFOBIP_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
BRAND_NAME=CliCab
# Limites par IP (par minute) pour les connexions et demandes de code
LOGIN_IP_PER_MIN=20
OTP_IP_PER_MIN=20
# Origines autorisées (back-office / site de réservation), séparées par des virgules
CORS_ORIGINS=http://localhost:3001,http://localhost:3002
# Routage réel (OSRM). Vide : estimation à vol d'oiseau. Ne pas utiliser le serveur de démonstration public en production.
ROUTING_URL=
# E-mails aux chauffeurs (annulations…) : console (dev) | resend. Sans fournisseur, le message reste dans l'application.
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=
# Montrer au chauffeur le prix client et la commission dans ses confirmations (0 = seulement sa rémunération nette)
DRIVER_SEES_CLIENT_PRICE=1
# Échelle de prix chauffeur : le prix proposé monte à l'approche de la mission, jusqu'au plafond (prix client − commission).
# PRICE_LADDER=0 la désactive (le chauffeur voit toujours le plafond).
PRICE_LADDER=1
# Part du plafond proposée au départ, début et fin de la hausse (minutes avant la prise en charge), pas de prix (centimes)
LADDER_START_RATIO=0.85
LADDER_FROM_MIN=1440
LADDER_TO_MIN=60
LADDER_STEP_CENTS=10
# Sauveteurs : critères d'accès à la liste d'élite (évalués à chaque appel) et prime versée au repreneur (prélevée sur la commission)
RESCUE_MIN_RATING=4.8
RESCUE_MIN_RELIABILITY=0.9
RESCUE_MIN_RIDES=30
RESCUE_BONUS_CENTS=1000
# Pénalités : part due si un sauveteur reprend la mission, plancher, fenêtre de comptage des récidives (jours)
PENALTY_RESCUE_RATIO=0.5
PENALTY_RESCUE_MIN_CENTS=1000
PENALTY_WINDOW_DAYS=90
# Critères d'admission du véhicule (source : fiche Service-Public vérifiée le 12/08/2026 ; à confirmer avec un juriste). VEHICLE_RULES=0 désactive le contrôle.
# Revenu minimal du chauffeur par course, net de commission, en centimes (9 € ; révisé chaque année).
MIN_DRIVER_PAY_CENTS=900
# Hybrides et électriques : exemptés d'âge, de puissance et de dimensions.
VEHICLE_RULES=1
# Badge d'accès aéroport (facture de parking ADP) : sans badge validé, pas de prise en charge dans ces zones ; le chauffeur reste en ligne pour le reste.
# Tout départ dont l'adresse contient « aéroport », plus les départs dans ces zones (adresse mal saisie). Aller vers l'aéroport reste libre.
# Exigence de l'exploitant, base légale non vérifiée. AIRPORT_BADGE_ENABLED=0 désactive la règle.
AIRPORT_BADGE_ENABLED=1
AIRPORT_BADGE_ZONES=CDG,ORLY,BEAUVAIS
VEHICLE_MIN_SEATS=4
VEHICLE_MAX_SEATS=9
VEHICLE_MAX_AGE_YEARS=7
VEHICLE_MIN_DOORS=4
VEHICLE_MIN_LENGTH_MM=4500
VEHICLE_MIN_WIDTH_MM=1700
VEHICLE_MIN_POWER_KW=84
# Vérification d'identité par selfie : durée de validité d'un selfie de prise de service (heures), conservation (jours). IDENTITY_CHECKS=0 désactive.
IDENTITY_CHECKS=1
IDENTITY_CHECK_HOURS=12
IDENTITY_RETENTION_DAYS=30
# Vérifications aléatoires en cours de service : intervalle moyen (min), écart minimal avec le dernier selfie (min), délai de réponse (min). IDENTITY_SPOT=0 désactive.
IDENTITY_SPOT=1
IDENTITY_SPOT_MEAN_MIN=240
IDENTITY_SPOT_MIN_GAP_MIN=90
IDENTITY_SPOT_DEADLINE_MIN=10

# Écran client : adresse publique du site de suivi (apps/web-booking) servant à fabriquer `trackingUrl`. Ajouter la même adresse à CORS_ORIGINS.
TRACKING_BASE_URL=http://localhost:3002
# Clés de test (sandbox) : n'envoient pas le lien de suivi au voyageur, sauf si TRACKING_NOTIFY_SANDBOX=1.

# Recrutement des chauffeurs (voir docs/RECRUTEMENT.md) : seuils réglables, valeurs par défaut indiquées
# APPLY_MIN_POINTS=8
# APPLY_MIN_FRENCH=60
# APPLY_MIN_ETHICS=70
# APPLY_MIN_ENGLISH=B1
# APPLY_MIN_YEARS=0
# REFERRAL_CODES_PER_DRIVER=3
# APPLY_RETEST_DAYS=30
# APPLY_RETENTION_DAYS=180
# APPLY_IP_PER_HOUR=5

# CRM : envoi commercial unitaire explicitement autorisé (Resend uniquement)
CRM_EMAIL_ENABLED=0
