DATABASE_URL=postgresql://vtc:vtc@localhost:5432/vtc?schema=public
PORT=3000
# Obligatoires en production (≥ 24 / ≥ 32 caractères)
ADMIN_TOKEN=change-me-change-me-change-me
TOKEN_SECRET=change-me-change-me-change-me-change-me
# Connexion chauffeur : code SMS à usage unique. En développement, les SMS sont écrits dans les journaux de l'API.
# DRIVER_DEV_OTP : code fixe accepté en dev UNIQUEMENT (utile pour le simulateur et les tests) ; refusé au démarrage en production.
DRIVER_DEV_OTP=000000
# Fournisseur SMS : console (dev) | twilio
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
BRAND_NAME=Étoile
# Limites par IP (par minute) pour les connexions et demandes de code
LOGIN_IP_PER_MIN=20
OTP_IP_PER_MIN=20
# Origines autorisées (back-office / site de réservation), séparées par des virgules
CORS_ORIGINS=http://localhost:3001
# Routage réel (OSRM). Vide : estimation à vol d'oiseau. Ne pas utiliser le serveur de démonstration public en production.
ROUTING_URL=
# E-mails aux chauffeurs (annulations…) : console (dev) | resend. Sans fournisseur, le message reste dans l'application.
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=
# Montrer au chauffeur le prix client et la commission dans ses confirmations (0 = seulement sa rémunération nette)
DRIVER_SEES_CLIENT_PRICE=1
# Échelle de prix chauffeur : le prix proposé monte à l'approche de la mission, jusqu'au plafond (prix client − commission).
# PRICE_LADDER=0 la désactive (le chauffeur voit toujours le plafond).
PRICE_LADDER=1
# Part du plafond proposée au départ, début et fin de la hausse (minutes avant la prise en charge), pas de prix (centimes)
LADDER_START_RATIO=0.85
LADDER_FROM_MIN=1440
LADDER_TO_MIN=60
LADDER_STEP_CENTS=10
# Sauveteurs : critères d'accès à la liste d'élite (évalués à chaque appel) et prime versée au repreneur (prélevée sur la commission)
RESCUE_MIN_RATING=4.8
RESCUE_MIN_RELIABILITY=0.9
RESCUE_MIN_RIDES=30
RESCUE_BONUS_CENTS=1000
