# Copier en infra/.env.prod (jamais commité) et renseigner. Les commentaires restent sur leur propre ligne.
API_DOMAIN=api.exemple.fr
ADMIN_DOMAIN=admin.exemple.fr
# Page de suivi du voyageur (lien envoyé par SMS et e-mail)
TRACK_DOMAIN=suivi.exemple.fr
# Site vitrine (fichiers de apps/site) ; créer aussi l'enregistrement DNS « www » vers le même serveur
SITE_DOMAIN=exemple.fr

# Mot de passe de la base : openssl rand -hex 24
POSTGRES_PASSWORD=
# Signe les sessions (32 caractères minimum) : openssl rand -hex 32
TOKEN_SECRET=
# Optionnel : token de service pour scripts. Vide = désactivé.
ADMIN_TOKEN=

# Routage routier (OSRM). Vide = estimation à vol d'oiseau.
ROUTING_URL=

# SMS des codes de connexion chauffeur. Sans fournisseur, la connexion chauffeur répond 501.
SMS_PROVIDER=ovh
# OVHcloud (compte SMS) : clés d'application et de consommateur, nom du service (sms-xx12345-1), expéditeur validé (facultatif)
OVH_APP_KEY=
OVH_APP_SECRET=
OVH_CONSUMER_KEY=
OVH_SMS_SERVICE=
OVH_SMS_SENDER=
# Alternative : Twilio (SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=CliCab
BRAND_NAME=CliCab

# E-mails aux chauffeurs (annulations…). Sans fournisseur, le message reste dans l'application.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=CliCab <noreply@exemple.fr>

# Échelle de prix chauffeur (voir README). PRICE_LADDER=0 pour la désactiver.
PRICE_LADDER=1
LADDER_START_RATIO=0.85
LADDER_FROM_MIN=1440
LADDER_TO_MIN=60

# Contrôles d'identité (selfies) et critères véhicule : 1 = actifs (recommandé), 0 = désactivés.
IDENTITY_CHECKS=1
IDENTITY_SPOT=1
VEHICLE_RULES=1

# Alertes : lien (Slack, Discord ou Mattermost « Incoming Webhook ») qui reçoit les erreurs graves de l'API, les plantages de l'application chauffeur
# et l'échec du contrôle hebdomadaire des sauvegardes. Vide : tout reste dans les journaux.
ERROR_WEBHOOK_URL=

# Sauvegarde de la base : fréquence (heures) et durée de conservation (jours) sur le serveur.
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14
