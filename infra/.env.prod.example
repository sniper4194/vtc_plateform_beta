# Copier en infra/.env.prod (jamais commité) et renseigner. Les commentaires restent sur leur propre ligne.
API_DOMAIN=api.exemple.fr
ADMIN_DOMAIN=admin.exemple.fr

# Mot de passe de la base : openssl rand -hex 24
POSTGRES_PASSWORD=
# Signe les sessions (32 caractères minimum) : openssl rand -hex 32
TOKEN_SECRET=
# Optionnel : token de service pour scripts. Vide = désactivé.
ADMIN_TOKEN=

# Routage routier (OSRM). Vide = estimation à vol d'oiseau.
ROUTING_URL=

# SMS des codes de connexion chauffeur. Sans fournisseur, la connexion chauffeur répond 501.
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=CliCab
BRAND_NAME=CliCab

# E-mails aux chauffeurs (annulations…). Sans fournisseur, le message reste dans l'application.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=CliCab <noreply@exemple.fr>

# Échelle de prix chauffeur (voir README). PRICE_LADDER=0 pour la désactiver.
PRICE_LADDER=1
LADDER_START_RATIO=0.85
LADDER_FROM_MIN=1440
LADDER_TO_MIN=60
